<view class="page">

  <view wx:if="{{loading}}" class="empty">加载试卷…</view>

  <block wx:if="{{!loading && cur}}">
    <view class="topbar">
      <view class="row-between">
        <view class="sub">{{session.title}}</view>
        <view class="timer">{{remainingText}}</view>
      </view>
      <view class="bar"><view class="bar-in" style="width: {{((index + 1) / total) * 100}}%"></view></view>
    </view>

    <view class="card">
      <view class="row meta">
        <text class="tag tag-gray">第 {{index + 1}} / {{total}} 题</text>
        <text class="tag {{isMulti ? 'tag-warn' : 'tag-primary'}}">{{isMulti ? '多选题（漏选得 0.5 分/项，错选 0 分）' : '单选题'}}</text>
      </view>
      <view class="stem">{{cur.stem}}</view>
    </view>

    <view class="card-flat">
      <view wx:for="{{optionsView}}" wx:key="key"
            class="option {{item.checked ? 'checked' : ''}}"
            data-key="{{item.key}}" bindtap="onToggleOption">
        <view class="opt-key">{{item.key}}</view>
        <view class="grow opt-text">{{item.text}}</view>
      </view>
    </view>

    <view class="page-bottom-space"></view>

    <view class="fixed-bottom">
      <view class="row-between">
        <view wx:if="{{index > 0}}" class="btn-ghost half" bindtap="goPrev">上一题</view>
        <view class="btn-ghost half" bindtap="onOpenCard">答题卡</view>
        <view class="btn" bindtap="goNext">下一题</view>
        <view class="btn submit" bindtap="onSubmit">交卷</view>
      </view>
    </view>

    <view wx:if="{{showCard}}" class="mask" bindtap="onOpenCard">
      <view class="sheet" catchtap="noop">
        <view class="row-between sheet-head">
          <view class="title">答题卡</view>
          <view class="sub">共 {{total}} 题 · 满分 {{fullScore}} 分</view>
        </view>
        <scroll-view scroll-y class="sheet-body">
          <view class="card-grid">
            <view wx:for="{{card}}" wx:key="*this" wx:for-index="i"
                  class="cell c-{{item}} {{i === index ? 'cur' : ''}}"
                  data-i="{{i}}" bindtap="onPickIndex">{{i + 1}}</view>
          </view>
        </scroll-view>
        <view class="btn submit" bindtap="onSubmit">交卷判分</view>
      </view>
    </view>
  </block>

  <block wx:if="{{!loading && !cur}}">
    <view class="empty">这份卷子还没有题目</view>
  </block>
</view>
