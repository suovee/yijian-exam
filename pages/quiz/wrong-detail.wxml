<view class="page">

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:if="{{!loading && question}}">
    <view class="card">
      <view class="row meta">
        <text class="tag {{question.type === 'multi' ? 'tag-warn' : 'tag-primary'}}">{{question.type === 'multi' ? '多选题' : '单选题'}}</text>
        <text wx:if="{{question.hasOverride}}" class="tag tag-warn">已按你的更正判题</text>
      </view>
      <view class="stem">{{question.stem}}</view>

      <view class="divider mid"></view>
      <view wx:for="{{question.options}}" wx:key="key" class="opt-line">
        <view class="opt-key">{{item.key}}</view>
        <view class="grow">{{item.text}}</view>
      </view>

      <view class="divider mid"></view>
      <view class="row-between">
        <view class="sub">参考答案</view>
        <view class="primary answer">{{answerText}}</view>
      </view>
      <view class="body analysis">{{question.effectiveAnalysis || '暂无解析'}}</view>
    </view>

    <view class="section-title">每一次作答（最近 {{totalAttempts}} 次，其中 {{wrongAttempts}} 次答错）</view>

    <view wx:if="{{history.length === 0}}" class="empty">还没有作答记录</view>

    <view wx:for="{{history}}" wx:key="id" class="card attempt">
      <view class="row-between">
        <view class="row">
          <text class="seq">第 {{item.no}} 次</text>
          <text class="tag {{item.correct ? 'tag-success' : 'tag-danger'}}">{{item.correct ? '正确' : '错误'}}</text>
        </view>
        <view class="sub">{{item.when}} · {{item.modeText}} · {{item.tookText}}</view>
      </view>

      <view class="picked">当时你选了：<text class="keys">{{item.picked || '（没选就跳过了）'}}</text></view>

      <block wx:if="{{item.wrongDetail.length}}">
        <view class="diff-title danger">错选（不该选的你选了）</view>
        <view wx:for="{{item.wrongDetail}}" wx:for-item="w" wx:key="key" class="diff-row">
          <view class="badge badge-bad">{{w.key}}</view>
          <view class="grow">{{w.text}}</view>
        </view>
      </block>

      <block wx:if="{{item.missedDetail.length}}">
        <view class="diff-title warn">漏选（该选的你没选）</view>
        <view wx:for="{{item.missedDetail}}" wx:for-item="m" wx:key="key" class="diff-row">
          <view class="badge badge-miss">{{m.key}}</view>
          <view class="grow">{{m.text}}</view>
        </view>
      </block>
    </view>

    <view class="card">
      <view class="title">觉得答案有问题？</view>
      <view class="sub tip">改答案不会动公共题库，只在你自己的账号里生效，别人看到的还是原题。</view>
      <view class="btn-ghost" bindtap="onCorrect">去更正这道题</view>
    </view>

    <view class="page-bottom-space"></view>
  </block>
</view>
