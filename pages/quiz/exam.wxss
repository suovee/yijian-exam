.topbar {
  padding: 20rpx 28rpx;
  background: #ffffff;
}

.timer {
  font-size: 30rpx;
  font-weight: 500;
  color: #d54941;
}

.bar {
  margin-top: 16rpx;
  height: 8rpx;
  background: #f1f3f5;
  border-radius: 4rpx;
  overflow: hidden;
}

.bar-in {
  height: 100%;
  background: #1a6fd4;
  border-radius: 4rpx;
}

.meta .tag {
  margin-right: 12rpx;
}

.stem {
  margin-top: 16rpx;
  font-size: 32rpx;
  line-height: 1.75;
  color: #1f2329;
}

.option {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  border-bottom: 2rpx solid #f1f3f5;
  background: #ffffff;
}

.option.checked {
  background: #f5f9ff;
}

.opt-key {
  width: 52rpx;
  height: 52rpx;
  line-height: 50rpx;
  text-align: center;
  border: 2rpx solid #d0d5dd;
  border-radius: 50%;
  color: #4e5969;
  font-size: 26rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option.checked .opt-key {
  background: #1a6fd4;
  border-color: #1a6fd4;
  color: #ffffff;
}

.opt-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: #1f2329;
  padding-top: 6rpx;
}

.half {
  width: 170rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.fixed-bottom .btn {
  flex: 1;
}

.submit {
  background: #d54941;
  margin-left: 16rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 40;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
}

.sheet-head {
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f1f3f5;
}

.sheet-body {
  max-height: 720rpx;
  padding: 24rpx 0;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 10rpx;
  background: #f1f3f5;
  color: #4e5969;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
}

.cell.c-done {
  background: #e8f1fc;
  color: #1a6fd4;
}

.cell.cur {
  border: 2rpx solid #1a6fd4;
}
