.hero {
  margin-top: 20rpx;
  padding: 40rpx 28rpx;
}

.score-row {
  align-items: baseline;
  margin-top: 16rpx;
}

.score {
  font-size: 96rpx;
  font-weight: 600;
  line-height: 1;
}

.slash {
  margin-left: 12rpx;
  font-size: 30rpx;
}

.info {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f1f3f5;
}

.right {
  text-align: right;
}

.auto-tip {
  margin-top: 16rpx;
}

.item {
  margin: 16rpx 24rpx;
}

.seq {
  font-weight: 500;
  margin-right: 16rpx;
}

.brief {
  margin: 14rpx 0;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1f2329;
}

.answer-row {
  padding-top: 12rpx;
}

.keys {
  font-weight: 500;
  letter-spacing: 3rpx;
  margin-left: 6rpx;
}

.grow {
  flex: 1;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
