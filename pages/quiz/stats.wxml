<view class="page">

  <view class="card total">
    <view class="row-between">
      <view class="stat-cell">
        <view class="stat-num primary">{{totals.answered}}</view>
        <view class="sub">累计答题</view>
      </view>
      <view class="stat-cell">
        <view class="stat-num success">{{totals.correct}}</view>
        <view class="sub">答对</view>
      </view>
      <view class="stat-cell">
        <view class="stat-num">{{totals.rate}}%</view>
        <view class="sub">总正确率</view>
      </view>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'subject' ? 'on' : ''}}" data-tab="subject" bindtap="onSwitchTab">分科</view>
    <view class="tab {{tab === 'progress' ? 'on' : ''}}" data-tab="progress" bindtap="onSwitchTab">章节进度</view>
    <view class="tab {{tab === 'exam' ? 'on' : ''}}" data-tab="exam" bindtap="onSwitchTab">考试记录</view>
    <view class="tab {{tab === 'favorite' ? 'on' : ''}}" data-tab="favorite" bindtap="onSwitchTab">收藏</view>
  </view>

  <view wx:if="{{loading}}" class="empty">统计中…</view>

  <view wx:if="{{!loading && tab === 'subject'}}" class="card-flat">
    <view wx:for="{{subjectsView}}" wx:key="code" class="subject-row">
      <view class="row-between">
        <view class="title">{{item.name}}</view>
        <view class="sub">{{item.correct}}/{{item.total}} 正确 · {{item.rate}}%</view>
      </view>
      <view class="bar"><view class="bar-in" style="width: {{item.width}}%"></view></view>
    </view>
  </view>

  <view wx:if="{{!loading && tab === 'progress'}}">
    <view wx:if="{{progressView.length === 0}}" class="empty">还没有章节进度，去做几道题就有了</view>
    <view class="card-flat">
      <view wx:for="{{progressView}}" wx:key="chapter" class="row-between pg">
        <view class="col grow">
          <view class="title small">{{item.chapter}}</view>
          <view class="sub">已练 {{item.done}} 题 · 正确 {{item.correct}} 题</view>
        </view>
        <view class="tag {{item.rate >= 80 ? 'tag-success' : (item.rate >= 60 ? 'tag-warn' : 'tag-danger')}}">{{item.rate}}%</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && tab === 'exam'}}">
    <view wx:if="{{examView.length === 0}}" class="empty">还没有交过卷</view>
    <view class="card-flat">
      <view wx:for="{{examView}}" wx:key="id" class="row-between ex" data-id="{{item.id}}" bindtap="openExam">
        <view class="col grow">
          <view class="title small">{{item.title}}</view>
          <view class="sub">{{item.typeText}} · {{item.when}}</view>
        </view>
        <view class="row">
          <view class="sub">{{item.percent}}%</view>
          <view class="tag tag-primary">{{item.scoreText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && tab === 'favorite'}}">
    <view wx:if="{{favView.length === 0}}" class="empty">还没有收藏</view>
    <view class="card-flat">
      <view wx:for="{{favView}}" wx:key="id" class="row-between fv" data-refid="{{item.refId}}" bindtap="openQuestion">
        <view class="row grow">
          <text class="tag tag-gray">{{item.typeText}}</text>
          <view class="grow title small">{{item.title}}</view>
        </view>
        <view class="arrow">›</view>
      </view>
    </view>
  </view>

  <view class="page-bottom-space"></view>
</view>
