<view class="page">

  <view class="card user-card">
    <block wx:if="{{logged}}">
      <view class="row-between">
        <view class="row">
          <view class="avatar">{{user.name ? user.name[0] : '备'}}</view>
          <view class="col user-info">
            <view class="title">{{user.name || '一建考生'}}</view>
            <view class="sub">今天已练 {{today.questions}} 题 · 学习 {{today.secondsText}}</view>
          </view>
        </view>
        <view class="btn-sm-ghost" bindtap="onLogout">退出</view>
      </view>
      <view class="row streak-row">
        <view class="tag tag-warn">连续打卡 {{streak}} 天</view>
        <view wx:if="{{today.checked}}" class="tag tag-success">今日已打卡</view>
        <view wx:else class="tag tag-gray">今日未打卡</view>
      </view>
    </block>
    <block wx:else>
      <view class="col center">
        <view class="title">登录后开始记录学习轨迹</view>
        <view class="sub tip">微信一键登录，作答流水、错题集、打卡都会保存在云端，换手机也不丢。</view>
        <view class="btn login-btn" bindtap="onLogin">微信一键登录</view>
      </view>
    </block>
  </view>

  <view class="section-title">我的学习</view>
  <view class="card-flat">
    <view class="row-between entry" bindtap="goProgress">
      <view class="col grow">
        <view class="title">学习进度</view>
        <view class="sub">四科章节进度与正确率</view>
      </view>
      <view class="arrow">›</view>
    </view>
    <view class="divider"></view>
    <view class="row-between entry" bindtap="goCheckin">
      <view class="col grow">
        <view class="title">每日打卡</view>
        <view class="sub">今日 {{today.questions}} 题，答对 {{today.correct}} 题</view>
      </view>
      <view class="arrow">›</view>
    </view>
    <view class="divider"></view>
    <view class="row-between entry" bindtap="goWrong">
      <view class="col grow">
        <view class="title">错题集</view>
        <view class="sub">保留每一次错选，可逐次回放</view>
      </view>
      <view class="arrow">›</view>
    </view>
    <view class="divider"></view>
    <view class="row-between entry" bindtap="goCorrections">
      <view class="col grow">
        <view class="title">题目更正</view>
        <view class="sub">对答案有异议时提交，采纳后仅本人生效</view>
      </view>
      <view class="arrow">›</view>
    </view>
    <view class="divider"></view>
    <view class="row-between entry" bindtap="goStats">
      <view class="col grow">
        <view class="title">学习统计</view>
        <view class="sub">分科数据、考试记录与收藏</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="section-title">管理</view>
  <view class="card-flat">
    <view class="row-between entry" bindtap="goMaterialAdmin">
      <view class="col grow">
        <view class="title">资料上传后台</view>
        <view class="sub">上传讲义 / 真题资料，所有人可见</view>
      </view>
      <view class="arrow">›</view>
    </view>
  </view>

  <view class="page-bottom-space"></view>
</view>
