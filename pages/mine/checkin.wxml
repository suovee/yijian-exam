<view class="page">

  <view wx:if="{{!logged}}" class="card">
    <view class="empty-inline">先在「我的」页面登录，打卡数据才会保存</view>
  </view>

  <block wx:if="{{logged}}">
    <view class="card today-card">
      <view class="row-between">
        <view class="col">
          <view class="title">今日打卡</view>
          <view class="sub">练 {{today.questions}} 题 · 对 {{today.correct}} 题 · 学 {{today.secondsText}}</view>
        </view>
        <view class="tag {{today.checked ? 'tag-success' : 'tag-warn'}}">{{today.checked ? '已打卡' : '未打卡'}}</view>
      </view>
      <view class="btn {{today.checked ? 'btn-disabled' : ''}}" bindtap="onCheckin">{{today.checked ? '今天已完成' : '立即打卡'}}</view>
      <view class="row stat-row">
        <view class="stat-cell">
          <view class="stat-num primary">{{streak}}</view>
          <view class="sub">连续天数</view>
        </view>
        <view class="stat-cell">
          <view class="stat-num">{{monthChecked}}</view>
          <view class="sub">本月打卡</view>
        </view>
        <view class="stat-cell">
          <view class="stat-num">{{monthDays}}</view>
          <view class="sub">本月天数</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="row-between month-nav">
        <view class="nav-btn" bindtap="onPrevMonth">‹</view>
        <view class="title">{{monthText}}</view>
        <view class="nav-btn" bindtap="onNextMonth">›</view>
      </view>
      <view class="week-row">
        <view wx:for="{{week}}" wx:key="*this" class="week-cell">{{item}}</view>
      </view>
      <view class="day-grid">
        <view wx:for="{{cells}}" wx:key="index" class="day-cell d-{{item.state}}">
          <view class="day-num">{{item.day}}</view>
        </view>
      </view>
      <view class="row legend">
        <view class="dot dot-on"></view><text class="sub">已打卡</text>
        <view class="dot dot-today"></view><text class="sub">今天</text>
      </view>
    </view>
  </block>
</view>
