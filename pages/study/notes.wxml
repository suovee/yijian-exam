<view class="page">

  <view wx:if="{{!logged}}" class="card">
    <view class="empty-inline">登录后才能看到你的知识点。<view class="btn-ghost mt" bindtap="goLogin">去登录</view></view>
  </view>

  <block wx:if="{{logged}}">
    <view class="filter-wrap">
      <scroll-view scroll-x="{{true}}" class="chips">
        <view class="chip-inner">
          <view wx:for="{{subjectChips}}" wx:key="code"
                class="chip {{subjectCode === item.code ? 'on' : ''}}"
                data-code="{{item.code}}" bindtap="onPickSubject">{{item.name}}</view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{loading}}" class="empty">加载中…</view>
    <view wx:if="{{!loading && list.length === 0}}" class="empty">还没有知识点</view>

    <view wx:for="{{list}}" wx:key="id" class="card note-card" data-id="{{item.id}}" bindtap="openNote">
      <view class="row-between">
        <view class="row">
          <text class="tag tag-primary">{{item.subjectName}}</text>
          <text wx:if="{{item.chapter}}" class="tag tag-gray">{{item.chapter}}</text>
          <text wx:if="{{item.imgCount}}" class="tag tag-success">{{item.imgCount}} 图</text>
        </view>
        <view class="sub">{{item.when}}</view>
      </view>
      <view class="note-title">{{item.title}}</view>
      <view wx:if="{{item.brief}}" class="sub brief">{{item.brief}}</view>
    </view>
  </block>

  <view class="page-bottom-space"></view>
  <view class="fab" bindtap="goCreate">＋</view>
</view>
