<view class="page">

  <view wx:if="{{!logged}}" class="card">
    <view class="empty-inline">登录后才能保存知识点和生成题目。<view class="btn-ghost mt" bindtap="goLogin">去登录</view></view>
  </view>

  <block wx:if="{{logged}}">
    <view class="card hero">
      <view class="title big">把书读薄</view>
      <view class="sub tip">拍照或手动整理知识点，攒够一个章节就能一键让 AI 出题，题目经你确认后进入题库。</view>
      <view class="row act-row">
        <view class="btn grow" bindtap="goCreate">＋ 新建知识点</view>
        <view class="btn-ghost grow" bindtap="goNotes">全部笔记</view>
      </view>
    </view>

    <view class="section-title">最近的知识点</view>
    <view wx:if="{{recent.length === 0}}" class="empty">还没有知识点，先从第一章开始记</view>
    <view class="card-flat">
      <view wx:for="{{recent}}" wx:key="id" class="row-between note" data-id="{{item.id}}" bindtap="openNote">
        <view class="col grow">
          <view class="title">{{item.title}}</view>
          <view class="sub">{{item.subjectName}} · {{item.when}}</view>
        </view>
        <view class="arrow">›</view>
      </view>
    </view>

    <view class="section-title">AI 出题</view>
    <view class="card-flat">
      <view class="row-between note" bindtap="goAi">
        <view class="col grow">
          <view class="title">按知识点生成题目</view>
          <view class="sub">生成结果先进草稿箱，你确认后才入公共题库</view>
        </view>
        <view class="arrow">›</view>
      </view>
      <view class="divider"></view>
      <view class="row-between note" bindtap="goDrafts">
        <view class="col grow">
          <view class="title">草稿箱审核</view>
          <view class="sub">{{pendingDrafts}} 条待确认</view>
        </view>
        <view wx:if="{{pendingDrafts}}" class="tag tag-warn">{{pendingDrafts}}</view>
        <view class="arrow">›</view>
      </view>
    </view>
  </block>

  <view class="page-bottom-space"></view>
</view>
