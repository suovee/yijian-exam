.filter-wrap {
  background: #ffffff;
  padding: 16rpx 24rpx 20rpx;
  border-bottom: 2rpx solid #f1f3f5;
}

.chips {
  white-space: nowrap;
}

.chip-inner {
  display: inline-flex;
}

.chip {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: #f7f8fa;
  color: #4e5969;
  font-size: 26rpx;
  margin-right: 16rpx;
}

.chip.on {
  background: #e8f1fc;
  color: #1a6fd4;
}

.cats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.cat {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #8a8f99;
  background: #f7f8fa;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.cat.on {
  color: #1a6fd4;
  background: #e8f1fc;
}

.search {
  margin-top: 12rpx;
}

.search .btn-sm {
  margin-left: 16rpx;
  flex-shrink: 0;
}

.mat {
  margin: 16rpx 24rpx;
}

.mat-title {
  margin: 16rpx 0 10rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2329;
  line-height: 1.5;
}

.desc {
  margin-bottom: 10rpx;
  line-height: 1.6;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background: #1a6fd4;
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(26, 111, 212, 0.4);
  z-index: 20;
}
