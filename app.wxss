page {
  background: #f4f6f9;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.05);
}

.card-flat {
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.grow {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2329;
}

.sub {
  font-size: 24rpx;
  color: #8a8f99;
}

.body {
  font-size: 28rpx;
  color: #4e5969;
}

.primary {
  color: #1a6fd4;
}

.danger {
  color: #d54941;
}

.success {
  color: #00a870;
}

.warn {
  color: #d98026;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #1a6fd4;
  color: #ffffff;
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #ffffff;
  color: #1a6fd4;
  border: 2rpx solid #1a6fd4;
}

.btn-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #1a6fd4;
  color: #ffffff;
}

.btn-sm-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  background: #ffffff;
  color: #1a6fd4;
  border: 2rpx solid #1a6fd4;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.tag-primary { background: #e8f1fc; color: #1a6fd4; }
.tag-success { background: #e3f6ec; color: #00a870; }
.tag-warn { background: #fdf1e3; color: #d98026; }
.tag-danger { background: #fdecea; color: #d54941; }
.tag-gray { background: #f1f3f5; color: #8a8f99; }

.divider {
  height: 2rpx;
  background: #f1f3f5;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #f1f3f5;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #8a8f99;
  font-size: 28rpx;
}

.section-title {
  padding: 32rpx 28rpx 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2329;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
}

.grid-2 > view {
  width: 50%;
}

.grid-3 > view {
  width: 33.33%;
}

.fixed-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 2rpx solid #f1f3f5;
  z-index: 20;
}

.page-bottom-space {
  height: 180rpx;
}
