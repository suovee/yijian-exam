# ===== 本地辅助服务配置（复制为 .env 后填写）=====

# 服务监听端口（小程序端 LOCAL.serverUrl 要对应）
SERVER_PORT=8787

# 微信小程序凭证（去微信公众平台 → 开发管理 → 开发设置 获取）
WX_APPID=wx_your_appid
WX_SECRET=your_appsecret

# JWT 签名密钥——必须与 docker-compose.yml 里的 PGRST_JWT_SECRET 完全一致
JWT_SECRET=localdev-secret-please-change

# 数据库连接（docker-compose 已把 5432 映射到本机）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# 大模型（OpenAI 兼容接口；本地也可用 vLLM / Ollama 的兼容端点）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini
